---
import '@fontsource-variable/inter/wght.css'
import SpaceHome from '../components/SpaceHome.astro'

const title = 'BookOrbit - Your reading space'
const description =
  'A self-hosted library and reading platform for ebooks, audiobooks, comics, and PDFs.'

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'BookOrbit',
  description,
  url: 'https://bookorbit.app/',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Docker (Linux, macOS, Windows)',
  license: 'https://www.gnu.org/licenses/agpl-3.0.html',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  screenshot: 'https://bookorbit.app/images/home/dashboard-overview.webp',
  softwareHelp: 'https://bookorbit.app/what-is-bookorbit',
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#06091a" />
    <meta name="description" content={description} />
    <link rel="canonical" href="https://bookorbit.app/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://api.github.com" crossorigin />
    <link
      rel="preload"
      as="image"
      href="/images/home/dashboard-overview.webp"
      imagesrcset="/images/home/dashboard-overview-800.webp 800w, /images/home/dashboard-overview.webp 1200w, /images/home/dashboard-overview-1600.webp 1600w, /images/home/dashboard-overview-2000.webp 2000w"
      imagesizes="(max-width: 960px) 92vw, 65vw"
      fetchpriority="high"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BookOrbit" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://bookorbit.app/" />
    <meta property="og:image" content="https://bookorbit.app/images/home/dashboard-overview.webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="719" />
    <meta
      property="og:image:alt"
      content="BookOrbit dashboard with reading statistics and book shelves"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
  </head>
  <body>
    <SpaceHome />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    background: #06091a;
    color-scheme: dark;
  }
</style>
