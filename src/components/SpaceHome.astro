---
import StarField from './StarField.astro'

const DEMO_URL =
  'https://demo.bookorbit.app/magic?token=2d92cb900e184cf0eb8b11f72cffc6011673d1016e1b300d750eb3d76abc1572'
const REPO_URL = 'https://github.com/bookorbit/bookorbit'

const features = [
  {
    name: 'Docker deployment',
    detail: 'One Compose file, local storage, no subscription.',
    icon: '<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/>',
  },
  {
    name: 'Multi-format readers',
    detail: 'Built-in readers for ebooks, PDF, comics, and audiobooks.',
    icon: '<path d="M12 7c-1.8-1.3-4-2-6.5-2H3v13h2.5c2.5 0 4.7.7 6.5 2 1.8-1.3 4-2 6.5-2H21V5h-2.5C16 5 13.8 5.7 12 7Z"/><path d="M12 7v13"/>',
  },
  {
    name: 'Multi-user + OIDC/SSO',
    detail: 'Per-user libraries, permissions, and provider login.',
    icon: '<path d="M16 19v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 17.5V19"/><circle cx="10" cy="8" r="3.2"/><path d="M20 19v-1.5a3.5 3.5 0 0 0-2.6-3.4M15.5 5.2a3.2 3.2 0 0 1 0 5.6"/>',
  },
  {
    name: 'Powerful metadata',
    detail: '9 providers, bulk editing, and field-level rules.',
    icon: '<path d="M3.6 11.6 11.6 3.6a2 2 0 0 1 1.5-.6l5.4.3a2 2 0 0 1 1.9 1.9l.3 5.4a2 2 0 0 1-.6 1.5l-8 8a2 2 0 0 1-2.8 0l-5.7-5.7a2 2 0 0 1 0-2.8Z"/><circle cx="15.8" cy="8.2" r="1.4"/>',
  },
  {
    name: 'Kobo + KOReader sync',
    detail: 'Two-way progress sync with Kobo and KOReader.',
    icon: '<path d="M20 11a8 8 0 0 0-13.7-5.3L4 8"/><path d="M4 4v4h4"/><path d="M4 13a8 8 0 0 0 13.7 5.3L20 16"/><path d="M20 20v-4h-4"/>',
  },
  {
    name: 'Book Dock',
    detail: 'Stage uploads, review metadata, then finalize.',
    icon: '<path d="M5.5 5h13l1.5 8v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4Z"/><path d="M3 13h4.5l1.5 2.5h6l1.5-2.5H21"/>',
  },
  {
    name: 'OPDS catalog',
    detail: 'Private feed for KOReader, Thorium, Moon+, and more.',
    icon: '<circle cx="5.5" cy="18.5" r="1.4" fill="currentColor" stroke="none"/><path d="M4 12.5a7.5 7.5 0 0 1 7.5 7.5"/><path d="M4 6a14 14 0 0 1 14 14"/>',
  },
  {
    name: 'Reading analytics',
    detail: 'Charts and widgets for library and reading insights.',
    icon: '<path d="M3 20h18"/><path d="M6.5 20v-5.5M11.5 20V5M16.5 20v-8.5M21 20v-3"/>',
  },
]

/* Hero gallery. The first entry is the LCP image and ships eagerly; the rest
   carry their URLs in data-* until the page has loaded or a tab is hovered.
   Every source lives in /images/home so the hero stays independent of the
   docs screenshots. Widths listed here must exist as -<width>.webp variants
   (see RESPONSIVE in scripts/optimize-images.js). */
const HERO_WIDTHS = [800, 1200, 2000]

const shots = [
  /* Land on the product, then browse it */
  {
    label: 'Dashboard',
    file: 'dashboard-overview',
    widths: [800, 1200, 1600, 2000],
    height: 692,
    alt: 'BookOrbit dashboard showing reading stats, currently reading shelf, and book collections',
  },
  /* Zoom into one book and how its metadata is built */
  {
    label: 'Book Details',
    file: 'book-details',
    height: 696,
    alt: 'A book details page with the cover, ratings from six metadata providers, genre tags, publisher and file details, per-format progress, and a similar books shelf',
  },
  {
    label: 'Edit Metadata',
    file: 'edit-metadata',
    height: 696,
    alt: 'The metadata editor with per-field locks, provider IDs, series and publisher fields, and a rich text description',
  },
  /* Back out to the author and the series it sits in */
  {
    label: 'Authors',
    file: 'authors-grid',
    height: 696,
    alt: 'The authors browser as a grid of author portraits with book counts',
  },
  {
    label: 'Series',
    file: 'series-detail',
    height: 696,
    alt: 'A series page for The Chronicles of Narnia showing reading progress and all seven books in order',
  },
  /* Read it, in each format */
  {
    label: 'Ebook Reader',
    file: 'ebook-reader',
    height: 696,
    alt: 'The built-in ebook reader in two-page layout with the appearance panel open on text size, page colour, and fonts',
  },
  {
    label: 'Comics Reader',
    file: 'comics-reader',
    height: 696,
    alt: 'The comics reader on a two-page spread with the settings panel open on fit mode, page view, and spread alignment',
  },
  {
    label: 'Audiobook Player',
    file: 'audiobook-player',
    height: 696,
    alt: 'The audiobook player showing cover art, chapter title, scrub bar, and speed, chapters, volume, and sleep controls',
  },
  /* What reading leaves behind */
  {
    label: 'Annotations',
    file: 'annotations',
    height: 696,
    alt: 'The annotations hub listing highlights and notes from web and KOReader, each tied to a book, chapter, and page',
  },
  {
    label: 'Reading Log',
    file: 'reading-log',
    height: 696,
    alt: 'A book reading log with progress journey chart, activity calendar, reading history, and recorded sessions',
  },
  /* Step back out to the numbers */
  {
    label: 'Reading Stats',
    file: 'reading-stats',
    height: 696,
    alt: 'Personal reading statistics with a yearly heatmap, peak reading hours, favourite days, and a completion funnel',
  },
  {
    label: 'Analytics',
    file: 'reading-analytics',
    height: 696,
    alt: 'Reading analytics with pace against goal, completion latency, a 24-hour reading clock, and genre reading time',
  },
  {
    label: 'Library Stats',
    file: 'library-stats',
    height: 696,
    alt: 'Library statistics with integrity and freshness gauges, format distribution, metadata scores, and a genre treemap',
  },
  {
    label: 'Achievements',
    file: 'achievements',
    height: 696,
    alt: 'The achievements page with tiered reading and library badges marked earned, in progress, or locked',
  },
  /* Set it up and reach the devices */
  {
    label: 'Metadata Rules',
    file: 'metadata-field-rules',
    height: 696,
    alt: 'Metadata field rules assigning provider priority and a merge strategy to each field such as title, cover, and authors',
  },
  {
    label: 'KOReader Sync',
    file: 'koreader-sync',
    height: 696,
    alt: 'KOReader sync settings with connection status, plugin server URL, plugin download, and registered devices',
  },
  {
    label: 'KOReader Plugin',
    file: 'koreader-plugin',
    height: 696,
    alt: 'The BookOrbit plugin running on an e-ink device, showing the reading dashboard, the all-books grid, and a book page with a download button',
  },
].map(shot => ({
  ...shot,
  src: `/images/home/${shot.file}.webp`,
  srcset: (shot.widths ?? HERO_WIDTHS)
    .map(w => `/images/home/${shot.file}${w === 1200 ? '' : `-${w}`}.webp ${w}w`)
    .join(', '),
}))
---

<div class="sh">
  <StarField />
  <div class="sh-nb sh-nb-1"></div>
  <div class="sh-nb sh-nb-2"></div>
  <div class="sh-nb sh-nb-3"></div>

  <header class="sh-header">
    <a href="/" class="sh-brand">
      <svg width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true">
        <defs>
          <linearGradient id="bp" x1="9" y1="7" x2="21" y2="23" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#93c5fd"></stop>
            <stop offset="100%" stop-color="#1d4ed8"></stop>
          </linearGradient>
          <linearGradient id="br" x1="1" y1="15" x2="29" y2="15" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#60a5fa" stop-opacity="0.3"></stop>
            <stop offset="50%" stop-color="#93c5fd"></stop>
            <stop offset="100%" stop-color="#60a5fa" stop-opacity="0.3"></stop>
          </linearGradient>
        </defs>
        <circle cx="15" cy="15" r="7.5" fill="url(#bp)"></circle>
        <ellipse
          cx="15"
          cy="15"
          rx="14"
          ry="5"
          fill="none"
          stroke="url(#br)"
          stroke-width="1.8"
          transform="rotate(-22,15,15)"></ellipse>
        <circle cx="15" cy="15" r="2.2" fill="rgba(255,255,255,0.3)"></circle>
      </svg>
      <span>BookOrbit</span>
    </a>

    <nav class="sh-nav" aria-label="Main">
      <a href="/what-is-bookorbit" class="sh-nav-link">Docs</a>
      <a href="/installation" class="sh-nav-link sh-nav-install">Installation</a>
      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener"
        class="sh-nav-gh"
        aria-label="BookOrbit on GitHub"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.09.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.088 2.91.832.091-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"
          ></path>
        </svg>
        <span class="sh-gh-label">GitHub</span>
        <span class="sh-gh-stars" data-repo-stars hidden></span>
      </a>
    </nav>
  </header>

  <main class="sh-main">
    <div class="sh-text">
      <p class="sh-eyebrow sh-rise" style="--i:0">
        <span>Open source</span>
        <span class="sh-eyebrow-sep" aria-hidden="true">&middot;</span>
        <span>AGPL-3.0</span>
      </p>

      <h1 class="sh-h1 sh-rise" style="--i:1">
        BookOrbit<br />
        <span class="sh-accent">Your reading space.</span>
      </h1>

      <p class="sh-desc sh-rise" style="--i:2">
        A self-hosted home for your ebooks, audiobooks, comics, and PDFs.<br />
        Your files stay on your hardware, and every device stays in sync.
      </p>

      <div class="sh-ctas sh-rise" style="--i:3">
        <a href={DEMO_URL} target="_blank" rel="noopener" class="sh-btn sh-btn-alt">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            style="flex-shrink:0"
            ><path d="M12 1l2.5 8.5L23 12l-8.5 2.5L12 23l-2.5-8.5L1 12l8.5-2.5Z"></path></svg
          >
          Try it live
        </a>
        <a href="/installation" class="sh-btn sh-btn-primary">
          Get started
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
          >
        </a>
      </div>

      <h2 class="sh-sr-only">Features</h2>
      <ul class="sh-feats">
        {
          features.map((feature, index) => (
            <li
              class="sh-feat sh-rise"
              style={`--i:${index + 4}`}
            >
              <span class="sh-feat-icon" aria-hidden="true">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={feature.icon}
                />
              </span>
              <span class="sh-feat-body">
                <span class="sh-feat-name">{feature.name}</span>
                <span class="sh-feat-detail">{feature.detail}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="sh-visual" data-gallery>
      <div class="sh-glow"></div>

      <div class="sh-tilt-wrap">
        <div class="sh-app-frame">
          <button type="button" class="sh-zoom" data-zoom>
            <span class="sh-sr-only">View screenshot full screen</span>
            <span class="sh-zoom-badge" aria-hidden="true">
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M15 3h6v6M9 21H3v-6M21 3l-7.5 7.5M3 21l7.5-7.5"></path></svg
              >
              Expand
            </span>
          </button>
          {
            shots.map((shot, index) => (
              <div
                class:list={['sh-shot', index === 0 && 'is-active']}
                role="tabpanel"
                id={`sh-shot-${index}`}
                aria-labelledby={`sh-tab-${index}`}
                aria-hidden={index === 0 ? undefined : 'true'}
              >
                <img
                  src={index === 0 ? shot.src : undefined}
                  srcset={index === 0 ? shot.srcset : undefined}
                  data-src={index === 0 ? undefined : shot.src}
                  data-srcset={index === 0 ? undefined : shot.srcset}
                  sizes="(max-width: 960px) 92vw, calc(62vw - 64px)"
                  width={1200}
                  height={shot.height}
                  alt={shot.alt}
                  fetchpriority={index === 0 ? 'high' : 'low'}
                  decoding="async"
                />
              </div>
            ))
          }
        </div>

        {/* Hangs off the bottom of the frame rather than sitting in the flow,
        so the frame itself lands on the column's centre line and stays level
        with the copy beside it. */}
        <div class="sh-shot-controls">
        <div class="sh-shot-nav" role="tablist" aria-label="Screenshots">
          {
            shots.map((shot, index) => (
              <button
                type="button"
                role="tab"
                class="sh-shot-tab"
                id={`sh-tab-${index}`}
                aria-controls={`sh-shot-${index}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
                aria-label={shot.label}
              />
            ))
          }
        </div>

          {/* Names only the selected screen, so 16 dots stay a row of dots */}
          <p class="sh-shot-label" data-shot-label aria-hidden="true">{shots[0].label}</p>
        </div>
      </div>
    </div>
  </main>

  <dialog class="sh-lb" data-lightbox aria-label="Screenshot viewer">
    <button type="button" class="sh-lb-close" data-lb-close>
      <span class="sh-sr-only">Close</span>
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg
      >
    </button>

    <button type="button" class="sh-lb-step sh-lb-prev" data-lb-prev>
      <span class="sh-sr-only">Previous screenshot</span>
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg
      >
    </button>

    <figure class="sh-lb-figure">
      <img class="sh-lb-img" data-lb-img sizes="96vw" alt="" decoding="async" />
      <figcaption class="sh-lb-cap">
        <span data-lb-label></span>
        <span class="sh-lb-count" data-lb-count></span>
      </figcaption>
    </figure>

    <button type="button" class="sh-lb-step sh-lb-next" data-lb-next>
      <span class="sh-sr-only">Next screenshot</span>
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg
      >
    </button>
  </dialog>

  <footer class="sh-footer">
    <span class="sh-footer-copy">&copy; {new Date().getFullYear()} BookOrbit</span>
  </footer>
</div>

<script>
  /* Live star count on the GitHub button. Fails silently so the button
     simply stays label-only when the API is unreachable or rate-limited. */
  const starsSlot = document.querySelector<HTMLElement>('[data-repo-stars]')
  if (starsSlot) {
    fetch('https://api.github.com/repos/bookorbit/bookorbit')
      .then(response => (response.ok ? response.json() : null))
      .then(data => {
        const count = data?.stargazers_count
        if (typeof count !== 'number' || count <= 0) return
        starsSlot.textContent =
          count >= 1000 ? `${(count / 1000).toFixed(1).replace(/\.0$/, '')}k` : String(count)
        starsSlot.hidden = false
      })
      .catch(() => {})
  }

  /* Screenshot gallery: tabs swap the slide shown inside the tilted frame */
  const gallery = document.querySelector<HTMLElement>('[data-gallery]')
  if (gallery) {
    const tabs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[role="tab"]'))
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>('[role="tabpanel"]'))
    const label = gallery.querySelector<HTMLElement>('[data-shot-label]')

    /* Deferred slides hold their URLs in data-* so they never compete with the
       LCP image. Promote one as soon as it is likely to be needed. */
    const load = (index: number) => {
      const img = slides[index]?.querySelector<HTMLImageElement>('img')
      const src = img?.dataset.src
      if (!img || !src) return
      if (img.dataset.srcset) img.srcset = img.dataset.srcset
      img.src = src
      delete img.dataset.src
      delete img.dataset.srcset
    }

    /* Three in flight at most: the visible screen and the one on either side,
       so stepping in either direction never lands on a blank frame. Fetching
       the whole gallery up front would be megabytes of screens most visitors
       never open. */
    const total = tabs.length
    const warm = (index: number) => {
      load(index)
      load((index - 1 + total) % total)
      load((index + 1) % total)
    }

    const select = (index: number, moveFocus = false) => {
      warm(index)
      tabs.forEach((tab, i) => {
        const selected = i === index
        tab.setAttribute('aria-selected', String(selected))
        tab.tabIndex = selected ? 0 : -1
        slides[i].classList.toggle('is-active', selected)
        if (selected) slides[i].removeAttribute('aria-hidden')
        else slides[i].setAttribute('aria-hidden', 'true')
      })
      if (label) label.textContent = tabs[index].getAttribute('aria-label') ?? ''
      if (moveFocus) tabs[index].focus()
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index))
      tab.addEventListener('pointerenter', () => load(index))
      tab.addEventListener('focus', () => load(index))
      tab.addEventListener('keydown', event => {
        const last = total - 1
        let next = -1
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = index === last ? 0 : index + 1
        else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = index === 0 ? last : index - 1
        else if (event.key === 'Home') next = 0
        else if (event.key === 'End') next = last
        if (next < 0) return
        event.preventDefault()
        select(next, true)
      })
    })

    /* Fill the starting window once the hero image is no longer competing */
    const warmFirst = () => warm(0)
    if (document.readyState === 'complete') warmFirst()
    else window.addEventListener('load', warmFirst, { once: true })

    /* ── Full-screen viewer ──
       A native <dialog> so the top layer, focus trapping, Esc-to-close and
       focus restoration all come from the platform. Captured once up front
       because load() moves each URL from data-src onto src. */
    const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox]')
    const zoom = gallery.querySelector<HTMLButtonElement>('[data-zoom]')

    if (lightbox && zoom && typeof lightbox.showModal === 'function') {
      const sources = slides.map(slide => {
        const img = slide.querySelector<HTMLImageElement>('img')
        return {
          src: img?.dataset.src ?? img?.getAttribute('src') ?? '',
          srcset: img?.dataset.srcset ?? img?.getAttribute('srcset') ?? '',
          alt: img?.alt ?? '',
        }
      })

      const lbImg = lightbox.querySelector<HTMLImageElement>('[data-lb-img]')
      const lbLabel = lightbox.querySelector<HTMLElement>('[data-lb-label]')
      const lbCount = lightbox.querySelector<HTMLElement>('[data-lb-count]')
      let current = 0

      const paint = (index: number) => {
        current = index
        /* Drive the page gallery too, so its warm window follows along and
           closing the viewer leaves the hero on the screen you stopped at */
        select(index)
        const shot = sources[index]
        if (lbImg) {
          lbImg.srcset = shot.srcset
          lbImg.src = shot.src
          lbImg.alt = shot.alt
        }
        if (lbLabel) lbLabel.textContent = tabs[index].getAttribute('aria-label') ?? ''
        if (lbCount) lbCount.textContent = `${index + 1} / ${total}`
      }

      const step = (delta: number) => paint((current + delta + total) % total)

      zoom.addEventListener('click', () => {
        paint(tabs.findIndex(tab => tab.getAttribute('aria-selected') === 'true'))
        lightbox.showModal()
        document.documentElement.style.overflow = 'hidden'
      })

      /* Every close path restores the scroll lock itself rather than trusting
         the dialog's close event, which not every engine delivers reliably */
      const restore = () => {
        document.documentElement.style.overflow = ''
      }
      const close = () => {
        lightbox.close()
        restore()
      }
      lightbox.querySelector('[data-lb-close]')?.addEventListener('click', close)
      lightbox.querySelector('[data-lb-prev]')?.addEventListener('click', () => step(-1))
      lightbox.querySelector('[data-lb-next]')?.addEventListener('click', () => step(1))
      lightbox.addEventListener('close', restore)
      lightbox.addEventListener('cancel', restore)

      /* Clicking the surround closes; clicking the picture itself must not */
      lightbox.addEventListener('click', event => {
        if (!(event.target instanceof Element)) return
        if (event.target.closest('.sh-lb-figure, button')) return
        close()
      })

      lightbox.addEventListener('keydown', event => {
        if (event.key === 'ArrowRight') {
          event.preventDefault()
          step(1)
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault()
          step(-1)
        } else if (event.key === 'Escape') {
          event.preventDefault()
          close()
        }
      })

      /* Swipe, for the phone layout */
      let swipeFrom: number | null = null
      const figure = lightbox.querySelector<HTMLElement>('.sh-lb-figure')
      figure?.addEventListener('pointerdown', event => {
        swipeFrom = event.clientX
      })
      figure?.addEventListener('pointerup', event => {
        if (swipeFrom === null) return
        const dx = event.clientX - swipeFrom
        swipeFrom = null
        if (Math.abs(dx) > 45) step(dx < 0 ? 1 : -1)
      })
    }
  }

</script>

