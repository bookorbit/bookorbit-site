---
import StarField from './StarField.astro'

const DEMO_URL =
  'https://demo.bookorbit.app/magic?token=2d92cb900e184cf0eb8b11f72cffc6011673d1016e1b300d750eb3d76abc1572'
const REPO_URL = 'https://github.com/bookorbit/bookorbit'

const features = [
  {
    name: 'Docker deployment',
    detail: 'One Compose file, local storage, no subscription.',
    icon: '<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/>',
  },
  {
    name: 'Multi-format readers',
    detail: 'Built-in readers for ebooks, PDF, comics, and audiobooks.',
    icon: '<path d="M12 7c-1.8-1.3-4-2-6.5-2H3v13h2.5c2.5 0 4.7.7 6.5 2 1.8-1.3 4-2 6.5-2H21V5h-2.5C16 5 13.8 5.7 12 7Z"/><path d="M12 7v13"/>',
  },
  {
    name: 'Multi-user + OIDC/SSO',
    detail: 'Per-user libraries, permissions, and provider login.',
    icon: '<path d="M16 19v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 17.5V19"/><circle cx="10" cy="8" r="3.2"/><path d="M20 19v-1.5a3.5 3.5 0 0 0-2.6-3.4M15.5 5.2a3.2 3.2 0 0 1 0 5.6"/>',
  },
  {
    name: 'Powerful metadata',
    detail: '9 providers, bulk editing, and field-level rules.',
    icon: '<path d="M3.6 11.6 11.6 3.6a2 2 0 0 1 1.5-.6l5.4.3a2 2 0 0 1 1.9 1.9l.3 5.4a2 2 0 0 1-.6 1.5l-8 8a2 2 0 0 1-2.8 0l-5.7-5.7a2 2 0 0 1 0-2.8Z"/><circle cx="15.8" cy="8.2" r="1.4"/>',
  },
  {
    name: 'Kobo + KOReader sync',
    detail: 'Two-way progress sync with Kobo and KOReader.',
    icon: '<path d="M20 11a8 8 0 0 0-13.7-5.3L4 8"/><path d="M4 4v4h4"/><path d="M4 13a8 8 0 0 0 13.7 5.3L20 16"/><path d="M20 20v-4h-4"/>',
  },
  {
    name: 'Book Dock',
    detail: 'Stage uploads, review metadata, then finalize.',
    icon: '<path d="M5.5 5h13l1.5 8v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4Z"/><path d="M3 13h4.5l1.5 2.5h6l1.5-2.5H21"/>',
  },
  {
    name: 'OPDS catalog',
    detail: 'Private feed for KOReader, Thorium, Moon+, and more.',
    icon: '<circle cx="5.5" cy="18.5" r="1.4" fill="currentColor" stroke="none"/><path d="M4 12.5a7.5 7.5 0 0 1 7.5 7.5"/><path d="M4 6a14 14 0 0 1 14 14"/>',
  },
  {
    name: 'Reading analytics',
    detail: 'Charts and widgets for library and reading insights.',
    icon: '<path d="M3 20h18"/><path d="M6.5 20v-5.5M11.5 20V5M16.5 20v-8.5M21 20v-3"/>',
  },
]
---

<div class="sh">
  <StarField />
  <div class="sh-nb sh-nb-1"></div>
  <div class="sh-nb sh-nb-2"></div>
  <div class="sh-nb sh-nb-3"></div>

  <header class="sh-header">
    <a href="/" class="sh-brand">
      <svg width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true">
        <defs>
          <linearGradient id="bp" x1="9" y1="7" x2="21" y2="23" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#93c5fd"></stop>
            <stop offset="100%" stop-color="#1d4ed8"></stop>
          </linearGradient>
          <linearGradient id="br" x1="1" y1="15" x2="29" y2="15" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#60a5fa" stop-opacity="0.3"></stop>
            <stop offset="50%" stop-color="#93c5fd"></stop>
            <stop offset="100%" stop-color="#60a5fa" stop-opacity="0.3"></stop>
          </linearGradient>
        </defs>
        <circle cx="15" cy="15" r="7.5" fill="url(#bp)"></circle>
        <ellipse
          cx="15"
          cy="15"
          rx="14"
          ry="5"
          fill="none"
          stroke="url(#br)"
          stroke-width="1.8"
          transform="rotate(-22,15,15)"></ellipse>
        <circle cx="15" cy="15" r="2.2" fill="rgba(255,255,255,0.3)"></circle>
      </svg>
      <span>BookOrbit</span>
    </a>

    <nav class="sh-nav" aria-label="Main">
      <a href="/what-is-bookorbit" class="sh-nav-link">Docs</a>
      <a href="/installation" class="sh-nav-link sh-nav-install">Installation</a>
      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener"
        class="sh-nav-gh"
        aria-label="BookOrbit on GitHub"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.09.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.088 2.91.832.091-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"
          ></path>
        </svg>
        <span class="sh-gh-label">GitHub</span>
        <span class="sh-gh-stars" data-repo-stars hidden></span>
      </a>
    </nav>
  </header>

  <main class="sh-main">
    <div class="sh-text">
      <p class="sh-eyebrow sh-rise" style="--i:0">
        <span>Open source</span>
        <span class="sh-eyebrow-sep" aria-hidden="true">&middot;</span>
        <span>AGPL-3.0</span>
      </p>

      <h1 class="sh-h1 sh-rise" style="--i:1">
        BookOrbit<br />
        <span class="sh-accent">Your reading space.</span>
      </h1>

      <p class="sh-desc sh-rise" style="--i:2">
        A self-hosted home for your ebooks, audiobooks, comics, and PDFs.<br />
        Your files stay on your hardware, and every device stays in sync.
      </p>

      <div class="sh-ctas sh-rise" style="--i:3">
        <a href={DEMO_URL} target="_blank" rel="noopener" class="sh-btn sh-btn-alt">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            style="flex-shrink:0"
            ><path d="M12 1l2.5 8.5L23 12l-8.5 2.5L12 23l-2.5-8.5L1 12l8.5-2.5Z"></path></svg
          >
          Try it live
        </a>
        <a href="/installation" class="sh-btn sh-btn-primary">
          Get started
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
          >
        </a>
      </div>

      <h2 class="sh-sr-only">Features</h2>
      <ul class="sh-feats">
        {
          features.map((feature, index) => (
            <li
              class="sh-feat sh-rise"
              style={`--i:${index + 4}`}
            >
              <span class="sh-feat-icon" aria-hidden="true">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={feature.icon}
                />
              </span>
              <span class="sh-feat-body">
                <span class="sh-feat-name">{feature.name}</span>
                <span class="sh-feat-detail">{feature.detail}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="sh-visual">
      <div class="sh-glow"></div>
      <div class="sh-tilt-wrap">
        <div class="sh-app-frame">
          <img
            src="/images/home/dashboard-overview.webp"
            srcset="/images/home/dashboard-overview-800.webp 800w, /images/home/dashboard-overview.webp 1200w, /images/home/dashboard-overview-1600.webp 1600w, /images/home/dashboard-overview-2000.webp 2000w"
            sizes="(max-width: 960px) 92vw, 65vw"
            width="1200"
            height="719"
            alt="BookOrbit dashboard showing reading stats, currently reading shelf, and book collections"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </main>

  <footer class="sh-footer">
    <span class="sh-footer-copy">&copy; {new Date().getFullYear()} BookOrbit</span>
  </footer>
</div>

<script>
  /* Live star count on the GitHub button. Fails silently so the button
     simply stays label-only when the API is unreachable or rate-limited. */
  const starsSlot = document.querySelector<HTMLElement>('[data-repo-stars]')
  if (starsSlot) {
    fetch('https://api.github.com/repos/bookorbit/bookorbit')
      .then(response => (response.ok ? response.json() : null))
      .then(data => {
        const count = data?.stargazers_count
        if (typeof count !== 'number' || count <= 0) return
        starsSlot.textContent =
          count >= 1000 ? `${(count / 1000).toFixed(1).replace(/\.0$/, '')}k` : String(count)
        starsSlot.hidden = false
      })
      .catch(() => {})
  }

  /* Pointer parallax on the dashboard screenshot */
  const tilt = document.querySelector<HTMLElement>('.sh-tilt-wrap')
  if (tilt) {
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)')
    const pointerQuery = window.matchMedia('(pointer: fine)')
    const BASE_X = 10
    const BASE_Y = -22
    const BASE_Z = 2

    let targetX = BASE_X
    let targetY = BASE_Y
    let currentX = BASE_X
    let currentY = BASE_Y
    let frameId = 0

    const apply = () => {
      currentX += (targetX - currentX) * 0.08
      currentY += (targetY - currentY) * 0.08

      const done = Math.abs(targetX - currentX) < 0.01 && Math.abs(targetY - currentY) < 0.01
      if (done) {
        currentX = targetX
        currentY = targetY
      }

      tilt.style.transform = `perspective(1000px) rotateX(${currentX.toFixed(2)}deg) rotateY(${currentY.toFixed(2)}deg) rotateZ(${BASE_Z}deg)`

      if (done) {
        frameId = 0
        return
      }
      frameId = requestAnimationFrame(apply)
    }

    const request = () => {
      if (!frameId) frameId = requestAnimationFrame(apply)
    }

    const isActive = () =>
      pointerQuery.matches && !motionQuery.matches && window.innerWidth > 960

    window.addEventListener(
      'pointermove',
      event => {
        if (!isActive()) return
        const dx = event.clientX / window.innerWidth - 0.5
        const dy = event.clientY / window.innerHeight - 0.5
        targetX = BASE_X - dy * 6
        targetY = BASE_Y + dx * 7
        request()
      },
      { passive: true },
    )

    window.addEventListener('pointerleave', () => {
      targetX = BASE_X
      targetY = BASE_Y
      request()
    })

    /* Drop the inline transform when the interaction no longer applies so the
       stylesheet's responsive tilt takes over again. */
    const reset = () => {
      if (isActive()) return
      cancelAnimationFrame(frameId)
      frameId = 0
      currentX = BASE_X
      currentY = BASE_Y
      targetX = BASE_X
      targetY = BASE_Y
      tilt.style.transform = ''
    }

    window.addEventListener('resize', reset)
    motionQuery.addEventListener('change', reset)
  }
</script>

<style>
  .sh {
    --sh-bg: #06091a;
    --sh-text-main: #e7efff;
    --sh-text-hero: #f3f7ff;
    --sh-text-nav: #b3c2dd;
    --sh-text-nav-strong: #cad8ee;
    --sh-text-body: #8a9fc2;
    --sh-text-body-strong: #d5e2f4;
    --sh-text-body-soft: #7f93ae;
    --sh-text-footer: #8ea2c2;
    --sh-text-footer-hover: #c8d7ee;
    --sh-accent-blue: #60a5fa;
    --sh-accent-cyan: #22d3ee;
    --sh-accent-green: #34d399;
    --sh-primary: #1d4ed8;
    --sh-primary-hover: #2563eb;
    --sh-white: #fff;
    --sh-white-05: rgba(255, 255, 255, 0.05);
    --sh-white-055: rgba(255, 255, 255, 0.055);
    --sh-white-065: rgba(255, 255, 255, 0.065);
    --sh-white-07: rgba(255, 255, 255, 0.07);
    --sh-white-08: rgba(255, 255, 255, 0.08);
    --sh-white-09: rgba(255, 255, 255, 0.09);
    --sh-white-10: rgba(255, 255, 255, 0.1);
    --sh-white-12: rgba(255, 255, 255, 0.12);
    --sh-white-20: rgba(255, 255, 255, 0.2);
    --sh-cyan-glow: rgba(34, 211, 238, 0.22);

    /* Vertical rhythm scales with viewport height so the fixed, non-scrolling
       layout still fits every element on short laptop screens. */
    --sh-gap-xs: clamp(6px, 1.1vh, 10px);
    --sh-gap-sm: clamp(8px, 1.7vh, 16px);
    --sh-gap-md: clamp(11px, 2.1vh, 20px);
    --sh-gap-lg: clamp(13px, 2.5vh, 26px);

    position: fixed;
    inset: 0;
    z-index: 99;
    overflow: hidden;
    background: var(--sh-bg);
    color: var(--sh-text-main);
    font-family: 'Inter Variable', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui,
      sans-serif;
    display: flex;
    flex-direction: column;
  }

  .sh :global(*),
  .sh :global(*::before),
  .sh :global(*::after) {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .sh-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Right-edge gradient fade so the screenshot dissolves into background
   instead of being hard-clipped by overflow:hidden on .sh */
  .sh::after {
    content: '';
    position: absolute;
    top: 60px;
    right: 0;
    bottom: 44px;
    width: 140px;
    background: linear-gradient(to right, transparent, var(--sh-bg) 82%);
    pointer-events: none;
    z-index: 8;
  }

  .sh-nb {
    position: absolute;
    border-radius: 50%;
    z-index: 0;
    pointer-events: none;
  }
  .sh-nb-1 {
    width: 860px;
    height: 860px;
    top: -340px;
    left: -240px;
    background: radial-gradient(circle, rgba(8, 145, 178, 0.18) 0%, transparent 58%);
  }
  .sh-nb-2 {
    width: 700px;
    height: 700px;
    bottom: -220px;
    right: -180px;
    background: radial-gradient(circle, rgba(29, 78, 216, 0.26) 0%, transparent 58%);
  }
  .sh-nb-3 {
    width: 480px;
    height: 480px;
    top: 22%;
    right: 18%;
    background: radial-gradient(circle, rgba(5, 150, 105, 0.055) 0%, transparent 58%);
  }

  /* ── Header ── */
  .sh-header {
    position: relative;
    z-index: 10;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 52px;
    height: 60px;
    border-bottom: 1px solid var(--sh-white-065);
    background: rgba(6, 9, 26, 0.7);
    backdrop-filter: blur(18px);
  }
  .sh-brand {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: var(--sh-text-main);
    font-size: 1.0625rem;
    font-weight: 640;
    letter-spacing: -0.015em;
  }
  .sh-brand svg {
    width: 30px;
    height: 30px;
  }
  .sh-nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .sh-nav-link {
    font-size: 0.84375rem;
    color: var(--sh-text-nav);
    text-decoration: none;
    letter-spacing: 0.01em;
    padding: 9px 11px;
    border-radius: 8px;
    transition: color 0.16s, background 0.16s;
  }
  .sh-nav-link:hover {
    color: var(--sh-text-main);
    background: var(--sh-white-05);
  }
  .sh-nav-gh {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 13px;
    margin-left: 4px;
    font-size: 0.84375rem;
    text-decoration: none;
    background: var(--sh-white-05);
    border: 1px solid var(--sh-white-10);
    border-radius: 8px;
    color: var(--sh-text-nav-strong);
    transition: background 0.16s, color 0.16s;
  }
  .sh-nav-gh:hover {
    background: var(--sh-white-09);
    color: var(--sh-text-main);
  }
  .sh-gh-stars {
    display: flex;
    align-items: center;
    gap: 3px;
    padding-left: 8px;
    margin-left: 2px;
    border-left: 1px solid var(--sh-white-12);
    font-variant-numeric: tabular-nums;
    color: var(--sh-text-nav);
  }
  .sh-gh-stars[hidden] {
    display: none;
  }
  .sh-gh-stars::before {
    content: '★';
    font-size: 0.75rem;
    color: #fbbf24;
  }

  /* ── Two-column grid ── */
  .sh-main {
    flex: 1;
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 38% 62%;
    align-items: center;
    padding: 0 0 0 72px;
    overflow: visible;
    min-height: 0;
  }

  /* ── Left: text ── */
  .sh-text {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 2;
    padding-right: 24px;
  }
  .sh-eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    font-size: clamp(0.625rem, 1.35vh, 0.6875rem);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sh-accent-blue);
    margin-bottom: var(--sh-gap-sm);
  }
  .sh-eyebrow-sep {
    opacity: 0.5;
  }
  .sh-h1 {
    font-size: clamp(1.85rem, min(3.4vw, 5.1vh), 3.4rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.04em;
    color: var(--sh-text-hero);
    margin-bottom: var(--sh-gap-sm);
  }
  .sh-accent {
    background: linear-gradient(
      118deg,
      var(--sh-accent-blue) 0%,
      var(--sh-accent-cyan) 52%,
      var(--sh-accent-green) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 0 24px var(--sh-cyan-glow));
  }
  .sh-desc {
    font-size: clamp(0.8125rem, 1.6vh, 0.90625rem);
    line-height: 1.6;
    color: var(--sh-text-body);
    margin-bottom: var(--sh-gap-lg);
  }

  /* CTAs */
  .sh-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: var(--sh-gap-md);
  }
  .sh-btn {
    padding: clamp(9px, 1.4vh, 11px) 20px;
    border-radius: 9px;
    font-size: 0.875rem;
    font-weight: 560;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    transition: background 0.16s, box-shadow 0.16s, transform 0.16s, color 0.16s;
  }
  .sh-btn-primary {
    background: var(--sh-primary);
    color: var(--sh-white);
    box-shadow: 0 0 26px rgba(29, 78, 216, 0.42), 0 2px 6px rgba(0, 0, 0, 0.3);
  }
  .sh-btn-primary:hover {
    background: var(--sh-primary-hover);
    box-shadow: 0 0 40px rgba(37, 99, 235, 0.58), 0 2px 8px rgba(0, 0, 0, 0.3);
    transform: translateY(-1px);
    color: var(--sh-white);
  }
  .sh-btn-alt {
    background: linear-gradient(var(--sh-bg), var(--sh-bg)) padding-box,
      linear-gradient(118deg, var(--sh-accent-blue), var(--sh-accent-cyan)) border-box;
    border: 1px solid transparent;
    color: var(--sh-accent-cyan);
    font-weight: 600;
    box-shadow: 0 0 14px rgba(34, 211, 238, 0.18);
    animation: sh-demo-glow 2.6s ease-in-out infinite;
  }
  .sh-btn-alt:hover {
    animation: none;
    background: linear-gradient(rgba(34, 211, 238, 0.07), rgba(34, 211, 238, 0.07)) padding-box,
      linear-gradient(118deg, var(--sh-accent-blue), var(--sh-accent-cyan)) border-box;
    color: var(--sh-text-main);
    box-shadow: 0 0 26px rgba(34, 211, 238, 0.38);
    transform: translateY(-1px);
  }
  @keyframes sh-demo-glow {
    0%,
    100% {
      box-shadow: 0 0 12px rgba(34, 211, 238, 0.15);
    }
    50% {
      box-shadow: 0 0 22px rgba(34, 211, 238, 0.32);
    }
  }

  /* ── Feature grid ── */
  .sh-feats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sh-gap-sm) 18px;
    padding-top: var(--sh-gap-sm);
    border-top: 1px solid var(--sh-white-07);
    list-style: none;
  }
  .sh-feat {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .sh-feat-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    border: 1px solid rgba(96, 165, 250, 0.36);
